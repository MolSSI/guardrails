#!/bin/sh
# Manage candidate and successful agent build keys without sourcing untrusted data.

set -eu

key_file=.riprap/state/container/agent-build.env
candidate_file=.riprap/state/container/agent-build.candidate.env
pin_file=.riprap/user/agent-pin.env
version_pattern='^[0-9]+\.[0-9]+\.[0-9]+$'

die() { printf 'Riprap: %s\n' "$*" >&2; exit 1; }

# The ISO-8601 week-year and week. Both launchers must agree on this stamp, so it is
# exposed as an action that reports the stamp for any date rather than only for today.
iso_week() {
    # Normal launches use only date options shared by Linux and macOS.
    if [ "$#" -eq 0 ] || [ "$1" = now ]; then
        date -u +%G-W%V
    else
        date -u -d "$1" +%G-W%V
    fi
}

prepare() {
    mkdir -p .riprap/state/container
{% if install_claude %}
    claude_version=latest
{% endif %}
{% if install_codex %}
    codex_version=latest
{% endif %}
{% if install_opencode %}
    opencode_version=latest
{% endif %}
{% if install_claude or install_codex or install_opencode %}
    refresh="$(iso_week)"
{% else %}
    # This project installs no agent, so nothing tracks a current release and the weekly
    # refresh would rebuild an agent-free image for no reason.
    refresh=pinned
{% endif %}

    if [ -e "$pin_file" ]; then
        [ -f "$pin_file" ] && [ ! -L "$pin_file" ] || die "$pin_file must be a regular file"
        seen=0
{% if install_claude %}
        seen_claude=0
{% endif %}
{% if install_codex %}
        seen_codex=0
{% endif %}
{% if install_opencode %}
        seen_opencode=0
{% endif %}
        while IFS= read -r raw || [ -n "$raw" ]; do
            line=$(printf '%s' "$raw" | tr -d '\r')
            [ -n "$line" ] || die "$pin_file contains a malformed line: '$line'"
            case "$line" in
                *=*) name=${line%%=*}; value=${line#*=} ;;
                *) die "$pin_file contains a malformed line: '$line'" ;;
            esac
            # Checks run in a fixed precedence so that every launcher reports the same defect
            # for the same file: structure, then name, then whether the named agent is installed,
            # then repetition, then value.
            case "$name" in
                CLAUDE_VERSION)
{% if install_claude %}
                    [ "$seen_claude" -eq 0 ] || die "$pin_file contains duplicate CLAUDE_VERSION assignments" ;;
{% else %}
                    die "$pin_file: CLAUDE_VERSION names the Claude agent, which this project does not install" ;;
{% endif %}
                CODEX_VERSION)
{% if install_codex %}
                    [ "$seen_codex" -eq 0 ] || die "$pin_file contains duplicate CODEX_VERSION assignments" ;;
{% else %}
                    die "$pin_file: CODEX_VERSION names the Codex agent, which this project does not install" ;;
{% endif %}
                OPENCODE_VERSION)
{% if install_opencode %}
                    [ "$seen_opencode" -eq 0 ] || die "$pin_file contains duplicate OPENCODE_VERSION assignments" ;;
{% else %}
                    die "$pin_file: OPENCODE_VERSION names the OpenCode agent, which this project does not install" ;;
{% endif %}
                *) die "$pin_file contains unknown assignment '$name'" ;;
            esac
            [ -n "$value" ] || die "$pin_file: $name has an empty value"
            printf '%s' "$value" | grep -Eq "$version_pattern" ||
                die "$pin_file: $name must be an exact release version such as 1.2.3, but is '$value'"
            case "$name" in
{% if install_claude %}
                CLAUDE_VERSION) claude_version=$value; seen_claude=1 ;;
{% endif %}
{% if install_codex %}
                CODEX_VERSION) codex_version=$value; seen_codex=1 ;;
{% endif %}
{% if install_opencode %}
                OPENCODE_VERSION) opencode_version=$value; seen_opencode=1 ;;
{% endif %}
            esac
            seen=$((seen + 1))
        done < "$pin_file"
        [ "$seen" -gt 0 ] || die "$pin_file is empty"
        # While every installed agent is pinned, the build key is fixed rather than tracking the
        # week, so pinned releases are not reinstalled week after week.
        if {% if install_claude %}[ "$seen_claude" -eq 1 ] && {% endif %}{% if install_codex %}[ "$seen_codex" -eq 1 ] && {% endif %}{% if install_opencode %}[ "$seen_opencode" -eq 1 ] && {% endif %}true; then refresh=pinned; fi
    fi

    tmp=$candidate_file.tmp.$$
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    printf '{% if install_claude %}CLAUDE_VERSION=%s\n{% endif %}{% if install_codex %}CODEX_VERSION=%s\n{% endif %}{% if install_opencode %}OPENCODE_VERSION=%s\n{% endif %}REFRESH=%s\n' {% if install_claude %}"$claude_version" {% endif %}{% if install_codex %}"$codex_version" {% endif %}{% if install_opencode %}"$opencode_version" {% endif %}"$refresh" > "$tmp"
    mv "$tmp" "$candidate_file"
    trap - EXIT HUP INT TERM
}

case "${1:-prepare}" in
    prepare) prepare ;;
    promote)
        [ -f "$candidate_file" ] || die 'no agent build candidate exists'
        {% if install_claude %}[ "${2:-}" ] && {% endif %}{% if install_codex %}[ "${3:-}" ] && {% endif %}{% if install_opencode %}[ "${4:-}" ] && {% endif %}true ||
            die 'promote requires an exact release version for each installed agent'
        tmp=$candidate_file.promote.$$
        trap 'rm -f "$tmp"' EXIT HUP INT TERM
        sed '/^INSTALLED_/d' "$candidate_file" > "$tmp"
        printf '{% if install_claude %}INSTALLED_CLAUDE_VERSION=%s\n{% endif %}{% if install_codex %}INSTALLED_CODEX_VERSION=%s\n{% endif %}{% if install_opencode %}INSTALLED_OPENCODE_VERSION=%s\n{% endif %}' {% if install_claude %}"$2" {% endif %}{% if install_codex %}"$3" {% endif %}{% if install_opencode %}"$4" {% endif %}>> "$tmp"
        mv "$tmp" "$key_file"
        rm -f "$candidate_file"
        trap - EXIT HUP INT TERM ;;
    discard) rm -f "$candidate_file" ;;
    week) iso_week "${2:-now}" ;;
    *) die "unknown agent build action '$1'" ;;
esac
